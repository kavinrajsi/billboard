# Browser key: restrict to Map Tiles API + HTTP referrers (localhost, your domain).
GOOGLE_BROWSER_KEY=
# Server key: Routes API, Air Quality API, Weather API, Places API (New). Never ship to the browser.
GOOGLE_SERVER_KEY=
# Anthropic key for AI auto-align (admin "Auto-align (AI)"). Server only. Optional model override:
ANTHROPIC_API_KEY=
# AUTO_ALIGN_MODEL=claude-opus-5-5
PORT=3000
